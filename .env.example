# Cloudflare D1 — leave unset to run on deterministic mock data instead.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=95b93b33-f194-4f1e-9318-35b6511a5e49

# Meta Ad Library ingestion (/api/cron/ingest-meta) — leave unset to skip ingestion.
META_ACCESS_TOKEN=
META_SEED_PAGE_IDS=
META_AD_COUNTRIES=US

# Shared secret checked against the cron request's Authorization header.
CRON_SECRET=
