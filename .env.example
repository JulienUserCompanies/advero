# Cloudflare D1 — leave unset to run on deterministic mock data instead.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=95b93b33-f194-4f1e-9318-35b6511a5e49

# Meta Ad Library ingestion (/api/cron/ingest-meta) — leave unset to skip ingestion.
META_ACCESS_TOKEN=
META_SEED_PAGE_IDS=
META_AD_COUNTRIES=US

# Apple Ad Repository ingestion (/api/cron/ingest-apple) — EU-only, no auth
# needed on Apple's side. Leave APPLE_SEED_QUERIES unset to skip ingestion.
# Comma-separated app/developer names to resolve via entity search.
APPLE_SEED_QUERIES=
APPLE_AD_COUNTRIES=DE,FR,ES,IT,NL

# Shared secret checked against the cron request's Authorization header.
CRON_SECRET=

# Messaging-style classification (hook/angle + CTA type, shown on /dashboard's
# "Messaging style" section and the /trends pages) — an OpenRouter API key,
# free to create at openrouter.ai/keys. Uses openrouter/free (OpenRouter's
# free-model router, $0 per token, rate-limited rather than billed), one
# short call per new ad. Leave unset and ingestion still works exactly as
# before; ads just go untagged (no messaging-style section renders).
OPENROUTER_API_KEY=

# Supabase — user accounts and the followed-competitor list. Get these from
# the Supabase dashboard: Project Settings -> API. Leave unset and the app
# still works (archive browsing is public), but /login and following a
# competitor won't.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
